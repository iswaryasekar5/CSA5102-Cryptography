#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int n, i;

    printf("Enter binary plaintext: ");
    scanf("%s", s);

    n = strlen(s);
    printf("Padded plaintext: %s", s);

    if (n % 8 == 0) {
        printf("10000000");
    } else {
        printf("1");
        for (i = n + 1; i % 8 != 0; i++)
            printf("0");
    }

    return 0;
}
