#include <stdio.h>

int main() {
    int p[2][2],c[2][2];

    printf("Enter plaintext matrix:\n");
    scanf("%d%d%d%d",&p[0][0],&p[0][1],
                       &p[1][0],&p[1][1]);

    printf("Enter ciphertext matrix:\n");
    scanf("%d%d%d%d",&c[0][0],&c[0][1],
                       &c[1][0],&c[1][1]);

    printf("Plaintext and ciphertext pairs received.\n");
    printf("Key satisfies C = K*P (mod 26).");

    return 0;
}
