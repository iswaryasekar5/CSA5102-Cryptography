#include <stdio.h>
#include <string.h>

int main()
{
    char text[100], key[100];
    int i, j = 0;

    printf("Enter plaintext (uppercase): ");
    scanf("%s", text);

    printf("Enter key (uppercase): ");
    scanf("%s", key);

    printf("Cipher Text: ");

    for(i = 0; text[i] != '\0'; i++)
    {
        char ch = ((text[i] - 'A') + (key[j] - 'A')) % 26 + 'A';
        printf("%c", ch);

        j++;
        if(key[j] == '\0')
            j = 0;
    }

    return 0;
}
